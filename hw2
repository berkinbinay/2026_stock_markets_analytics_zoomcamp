import contextlib
import logging
import os
import re
from io import StringIO

import gdown
import numpy as np
import pandas as pd
import pyarrow.parquet as pq
import requests
import yfinance as yf

HEADERS = {"User-Agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64)"}

# Hide yfinance "possibly delisted" / 404 messages for missing tickers
logging.getLogger("yfinance").setLevel(logging.CRITICAL)

# Q1-Q3: IPO data
RECENTLY_FILED_URL = "https://www.iposcoop.com/ipos-recently-filed/"
PRICINGS_2025_URL = "https://www.iposcoop.com/2025-pricings/"
CUTOFF_DATE = pd.Timestamp("2025-09-01")
ANALYSIS_DATE = pd.Timestamp("2026-09-11")
RISK_FREE = 0.05
TRADING_DAYS_PER_MONTH = 21
MONTHS = range(1, 13)
GROWTH_COLS = [f"future_growth_{m}_m" for m in MONTHS]

# Q4: RSI strategy
RSI_FILE_ID = "1grCTCzMZKY5sJRtdbLVCXg8JXA8VPyg-"
RSI_DATA_PATH = "data.parquet"
RSI_THRESHOLD = 30
RSI_START, RSI_END = "2000-01-01", "2025-06-01"
INVESTMENT = 1000

# First matching rule wins (order matters). Plain case-sensitive substring match,
# so "Corp" also catches "Corporation", but "Technology" does not match "Technologies".
CLASS_RULES = [
    ("Technologies", ["Technologies"]),
    ("Acquisition Corp", ["Acquisition Corp", "Acquisition Corporation", "Corp"]),
    ("Inc.", ["Inc", "Incorporated"]),
    ("Group", ["Group"]),
    ("Limited", ["Ltd", "Limited"]),
    ("Holdings", ["Holdings", "Holding"]),
]


# ---------------------------------------------------------------------------
# Shared helpers
# ---------------------------------------------------------------------------
def find_col(df: pd.DataFrame, *candidates: str) -> str:
    """Locate a column by name, ignoring case/punctuation differences."""
    norm = lambda x: re.sub(r"[^a-z0-9]", "", str(x).lower())
    lookup = {norm(c): c for c in df.columns}
    for cand in candidates:
        if norm(cand) in lookup:
            return lookup[norm(cand)]
    raise KeyError(f"None of {candidates} found in columns: {list(df.columns)}")


def parse_number(value) -> float:
    """'$8.00' -> 8.0 ; '1,234.5' -> 1234.5 ; '12.5%' -> 12.5 ; '-' / missing -> NaN."""
    s = str(value).strip()
    if s in {"", "-", "—", "–", "nan", "NaN", "None"}:
        return np.nan
    try:
        return float(re.sub(r"[^0-9.\-]", "", s))
    except ValueError:
        return np.nan


def fetch_table(url: str, required_col: str) -> pd.DataFrame:
    """Download a page and return the first HTML table containing `required_col`."""
    response = requests.get(url, headers=HEADERS, timeout=30)
    response.raise_for_status()

    for table in pd.read_html(StringIO(response.text)):
        table.columns = [str(c).strip() for c in table.columns]
        try:
            find_col(table, required_col)
            return table
        except KeyError:
            continue
    raise ValueError(f"No table with a '{required_col}' column found at {url}")


# ---------------------------------------------------------------------------
# Q1: Withdrawn IPOs by company type
# ---------------------------------------------------------------------------
def classify_company(name: str) -> str:
    """Assign a company type using the first matching rule."""
    name = str(name)
    for label, keywords in CLASS_RULES:
        if any(keyword in name for keyword in keywords):
            return label
    return "Other"


def get_withdrawn_value_by_type() -> pd.Series:
    """Total withdrawn IPO value ($ millions) per company type."""
    df = fetch_table(RECENTLY_FILED_URL, "Expected To Trade")
    status = df[find_col(df, "Expected To Trade")].astype(str).str.strip().str.lower()
    df = df[status == "withdrawn"].copy()

    df["Company Type"] = df[find_col(df, "Company", "Company Name")].apply(classify_company)

    low = df[find_col(df, "Price Low")].apply(parse_number)
    high = df[find_col(df, "Price High")].apply(parse_number)
    df["Avg_price"] = pd.concat([low, high], axis=1).mean(axis=1, skipna=False)

    shares = df[find_col(df, "Shares (millions)")].apply(parse_number)
    est_vol = df[find_col(df, "Est $ Vol (millions)", "Est. $ Volume (millions)")].apply(parse_number)

    calc = shares * df["Avg_price"]
    df["Shares_offered_value"] = calc.where(calc.notna(), est_vol)

    return df.groupby("Company Type")["Shares_offered_value"].sum().sort_values(ascending=False)


# ---------------------------------------------------------------------------
# Q2-Q3: 2025 IPO prices, Sharpe ratio and fixed-holding growth
# ---------------------------------------------------------------------------
def get_filtered_ipos() -> pd.DataFrame:
    """2025 IPOs with offer date before the cutoff and a non-zero return."""
    ipos = fetch_table(PRICINGS_2025_URL, "Offer Date")

    ipos["offer_date"] = pd.to_datetime(ipos[find_col(ipos, "Offer Date")], errors="coerce")
    ipos["return_pct"] = ipos[find_col(ipos, "Return", "% Return")].apply(parse_number)
    ipos["ticker"] = ipos[find_col(ipos, "Symbol", "Ticker")].astype(str).str.strip().str.upper()

    mask = (
        (ipos["offer_date"] < CUTOFF_DATE)
        & (ipos["return_pct"] != 0)
        & ipos["ticker"].str.match(r"^[A-Z0-9.\-]+$")
    )
    return ipos[mask].drop_duplicates("ticker")


def download_prices(tickers: list[str]) -> pd.DataFrame:
    """Daily close prices; tickers missing from Yahoo Finance are skipped."""
    with open(os.devnull, "w") as devnull, \
            contextlib.redirect_stdout(devnull), contextlib.redirect_stderr(devnull):
        raw = yf.download(
            tickers,
            start="2025-01-01",
            end=(ANALYSIS_DATE + pd.Timedelta(days=1)).strftime("%Y-%m-%d"),
            group_by="ticker",
            auto_adjust=False,
            progress=False,
            threads=True,
        )

    frames = []
    for ticker in tickers:
        try:
            close = raw[ticker][["Close"]].dropna()
        except KeyError:
            continue
        if close.empty:
            continue
        frames.append(close.reset_index().assign(Ticker=ticker))

    if not frames:
        raise RuntimeError("No price data downloaded.")

    stocks_df = pd.concat(frames, ignore_index=True)
    return stocks_df.sort_values(["Ticker", "Date"]).reset_index(drop=True)


def add_sharpe_features(stocks_df: pd.DataFrame) -> pd.DataFrame:
    """growth_252d, 30-day volatility (std of price levels, per the task) and Sharpe."""
    close = stocks_df.groupby("Ticker")["Close"]
    stocks_df["growth_252d"] = stocks_df["Close"] / close.shift(252)
    stocks_df["volatility"] = close.transform(lambda s: s.rolling(30).std()) * np.sqrt(252)
    stocks_df["Sharpe"] = (stocks_df["growth_252d"] - RISK_FREE) / stocks_df["volatility"]
    return stocks_df


def add_future_growth(stocks_df: pd.DataFrame) -> pd.DataFrame:
    """future_growth_k_m = Close(t + 21*k trading days) / Close(t), per ticker."""
    close = stocks_df.groupby("Ticker")["Close"]
    for m in MONTHS:
        stocks_df[f"future_growth_{m}_m"] = (
            close.shift(-TRADING_DAYS_PER_MONTH * m) / stocks_df["Close"]
        )
    return stocks_df


def get_entry_points(stocks_df: pd.DataFrame) -> pd.DataFrame:
    """Keep only each ticker's first available trading day (inner join on min_date)."""
    min_dates = stocks_df.groupby("Ticker")["Date"].min().reset_index(name="min_date")
    return stocks_df.merge(
        min_dates, left_on=["Ticker", "Date"], right_on=["Ticker", "min_date"], how="inner"
    )


def analyze_sharpe(stocks_df: pd.DataFrame) -> pd.DataFrame:
    """Descriptive statistics of growth, volatility and Sharpe on the analysis date."""
    day = stocks_df[stocks_df["Date"] == ANALYSIS_DATE].replace([np.inf, -np.inf], np.nan)
    print(f"Rows on {ANALYSIS_DATE.date()}: {len(day)}")
    print(f"Stocks with 252-day history: {day['growth_252d'].notna().sum()}")

    print(day[["growth_252d", "volatility", "Sharpe"]].describe().round(4).to_string())
    print(f"\ngrowth_252d median={day['growth_252d'].median():.3f}  "
          f"mean={day['growth_252d'].mean():.3f}")

    day = day.assign(
        growth_rank=day["growth_252d"].rank(ascending=False),
        sharpe_rank=day["Sharpe"].rank(ascending=False),
    )
    better = day[day["sharpe_rank"] < day["growth_rank"]].nlargest(5, "growth_rank")
    print("\nRank better on Sharpe than on raw growth:")
    print(better[["Ticker", "growth_252d", "Sharpe", "growth_rank", "sharpe_rank"]]
          .to_string(index=False))
    return day


def analyze_holding_periods(stocks_df: pd.DataFrame) -> pd.DataFrame:
    """Median/mean growth from the IPO-day close for each 1-12 month horizon."""
    ipo_day = get_entry_points(stocks_df).replace([np.inf, -np.inf], np.nan)
    stats = ipo_day[GROWTH_COLS].describe()
    return pd.DataFrame({
        "median": stats.loc["50%"],
        "mean": stats.loc["mean"],
        "n_stocks": stats.loc["count"].astype(int),
    })


# ---------------------------------------------------------------------------
# Q4: RSI oversold strategy
# ---------------------------------------------------------------------------
def load_rsi_data() -> pd.DataFrame:
    """Download the parquet file (once) and read it, with a pyarrow fallback."""
    if not os.path.exists(RSI_DATA_PATH):
        gdown.download(f"https://drive.google.com/uc?id={RSI_FILE_ID}", RSI_DATA_PATH, quiet=False)

    try:
        return pd.read_parquet(RSI_DATA_PATH, engine="pyarrow")
    except Exception as e:  # e.g. the reticulate/pyarrow extension-type error
        print(f"pandas read_parquet failed ({type(e).__name__}); using pyarrow directly")
        return pq.read_table(RSI_DATA_PATH).to_pandas()


def get_rsi_trades() -> pd.DataFrame:
    """Oversold signals (RSI < threshold) with a known 30-day outcome."""
    df = load_rsi_data()

    try:
        date_col = find_col(df, "Date")
    except KeyError:  # some files store the date in the index
        df = df.reset_index()
        date_col = find_col(df, "Date")

    rsi_col = find_col(df, "rsi", "RSI")
    growth_col = find_col(df, "growth_future_30d")
    df[date_col] = pd.to_datetime(df[date_col])

    trades = df[
        (df[rsi_col] < RSI_THRESHOLD)
        & (df[date_col] >= RSI_START)
        & (df[date_col] <= RSI_END)
    ]
    trades = trades.replace([np.inf, -np.inf], np.nan).dropna(subset=[growth_col])
    return trades.assign(trade_return=trades[growth_col] - 1)


if __name__ == "__main__":
    print("=== Q1: Withdrawn IPO Value by Company Type ($ millions) ===")
    withdrawn = get_withdrawn_value_by_type()
    print(withdrawn.round(2).to_string())
    ranked = withdrawn.drop("Other", errors="ignore")  # 'Other' is a catch-all, not a class
    print(f"Answer: '{ranked.idxmax()}' = ${ranked.max():,.2f} million")

    print("\n=== Q2: Median Sharpe Ratio (2025 IPOs) ===")
    stocks_df = download_prices(get_filtered_ipos()["ticker"].tolist())
    sharpe_day = analyze_sharpe(add_sharpe_features(stocks_df))
    print(f"Answer: median Sharpe = {sharpe_day['Sharpe'].median():.4f}")

    print("\n=== Q3: Fixed Months Holding Strategy ===")
    holding = analyze_holding_periods(add_future_growth(stocks_df))
    print(holding.round(4).to_string())
    best = holding["median"].idxmax()
    print(f"Answer: optimal holding = {best.split('_')[2]} month(s), "
          f"median growth = {holding['median'].max():.4f}")

    print("\n=== Q4: RSI Oversold Strategy ===")
    trades = get_rsi_trades()
    net_income = INVESTMENT * trades["trade_return"].sum()
    print(f"Number of trades:   {len(trades):,}")
    print(f"Average 30d return: {trades['trade_return'].mean() * 100:.2f}%")
    print(f"Win rate:           {(trades['trade_return'] > 0).mean() * 100:.2f}%")
    print(f"Answer: net income = ${net_income:,.0f} (${net_income / 1000:,.1f} thousand)")
