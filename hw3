# 3. HANDCRAFTED RULES
# ============================================================

def create_handcrafted_predictions(df):
    """
    Reproduce the four handcrafted rules used in the homework.

    pred0: CCI > 200
    pred1: growth_30d > 1
    pred2: growth_30d > 1 AND growth_snp500_30d > 1
    pred3: DGS10 <= 4.5 AND DGS5 <= 4
    pred4: DGS10 > 4 AND FEDFUNDS <= 4.795
    """

    required_for_rules = [
        "cci",
        "growth_30d",
        "growth_snp500_30d",
        "DGS10",
        "DGS5",
        "FEDFUNDS",
    ]

    missing = [
        column for column in required_for_rules
        if column not in df.columns
    ]

    if missing:
        raise ValueError(
            "Cannot calculate the homework's handcrafted rules. "
            f"Missing columns: {missing}"
        )

    predictions = pd.DataFrame(index=df.index)

    predictions["pred0"] = (
        pd.to_numeric(df["cci"], errors="coerce") > 200
    ).astype(int)

    predictions["pred1"] = (
        pd.to_numeric(df["growth_30d"], errors="coerce") > 1
    ).astype(int)

    predictions["pred2"] = (
        (pd.to_numeric(df["growth_30d"], errors="coerce") > 1)
        & (
            pd.to_numeric(
                df["growth_snp500_30d"], errors="coerce"
            ) > 1
        )
    ).astype(int)

    predictions["pred3"] = (
        (pd.to_numeric(df["DGS10"], errors="coerce") <= 4.5)
        & (pd.to_numeric(df["DGS5"], errors="coerce") <= 4)
    ).astype(int)

    predictions["pred4"] = (
        (pd.to_numeric(df["DGS10"], errors="coerce") > 4)
        & (pd.to_numeric(df["FEDFUNDS"], errors="coerce") <= 4.795)
    ).astype(int)

    return predictions


def evaluate_predictions(y_true, y_pred, name):
    """Print classification metrics for a binary prediction."""

    print(f"\n{name}")
    print("-" * 50)

    print(f"Accuracy:  {accuracy_score(y_true, y_pred):.4f}")
    print(
        f"Precision: "
        f"{precision_score(y_true, y_pred, zero_division=0):.4f}"
    )
    print(
        f"Recall:    "
        f"{recall_score(y_true, y_pred, zero_division=0):.4f}"
    )
    print(
        f"F1 score:  "
        f"{f1_score(y_true, y_pred, zero_division=0):.4f}"
    )


