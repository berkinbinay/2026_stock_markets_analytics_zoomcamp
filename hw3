# Q3. DEPTH-10 TREE AND UNIQUE CORRECT POSITIVE PREDICTIONS
# ============================================================

def question_3(X_train, X_test, y_train, y_test, rules_test):
    print("\n" + "=" * 70)
    print("Q3 — DEPTH-10 DECISION TREE")
    print("=" * 70)

    tree = DecisionTreeClassifier(
        max_depth=10,
        random_state=RANDOM_STATE,
    )
    tree.fit(X_train, y_train)

    ml_pred = pd.Series(
        tree.predict(X_test),
        index=y_test.index,
        name="ml_prediction",
    )

    evaluate_predictions(y_test, ml_pred, "Decision tree, max_depth=10")

    # Find positive cases correctly identified by the ML model
    # but not correctly identified by either pred3 or pred4.
    actual_positive = y_test == 1
    ml_correct_positive = (ml_pred == 1) & actual_positive

    pred3_test = rules_test.loc[y_test.index, "pred3"]
    pred4_test = rules_test.loc[y_test.index, "pred4"]

    rules_missed = (pred3_test != 1) & (pred4_test != 1)

    unique_cases = ml_correct_positive & rules_missed

    print(
        "\nCases correctly predicted positive by the ML model "
        "but missed by BOTH pred3 and pred4:"
    )
    print(int(unique_cases.sum()))

    print("\nML positive predictions:", int((ml_pred == 1).sum()))
    print("Actual positive cases:", int(actual_positive.sum()))

    print("\nConfusion matrix (rows=actual, columns=predicted):")
    print(confusion_matrix(y_test, ml_pred, labels=[0, 1]))

    return tree, ml_pred, unique_cases


# ============================================================
# Q4. DECISION TREE DEPTHS 1–12
# ============================================================

def question_4(X_train, X_test, y_train, y_test):
    print("\n" + "=" * 70)
    print("Q4 — DECISION TREE HYPERPARAMETER TUNING")
    print("=" * 70)

    results = []

    for depth in range(1, 13):
        tree = DecisionTreeClassifier(
            max_depth=depth,
            random_state=RANDOM_STATE,
        )
        tree.fit(X_train, y_train)

        pred = tree.predict(X_test)

        results.append({
            "max_depth": depth,
            "accuracy": accuracy_score(y_test, pred),
            "precision": precision_score(
                y_test, pred, zero_division=0
            ),
            "recall": recall_score(
                y_test, pred, zero_division=0
            ),
            "f1": f1_score(
                y_test, pred, zero_division=0
            ),
            "predicted_positives": int((pred == 1).sum()),
        })

    results_df = pd.DataFrame(results)

    print(results_df.to_string(index=False, float_format=lambda x: f"{x:.4f}"))

    # Report the best test precision for transparency.
    # For rigorous model selection, tune on a validation set instead
    # of using test performance to choose the final model.
    best_row = results_df.loc[results_df["precision"].idxmax()]

    print("\nDepth with highest reported test precision:")
    print(f"Depth: {int(best_row['max_depth'])}")
    print(f"Precision: {best_row['precision']:.4f}")

    return results_df


