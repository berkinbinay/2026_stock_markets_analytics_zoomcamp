def prepare_target(df):
    """Convert the target to a binary variable and remove unknown labels."""

    df = df.copy()

    # Convert common Boolean representations to numeric 0/1.
    if df[TARGET].dtype == object:
        normalized = df[TARGET].astype(str).str.strip().str.lower()
        mapping = {
            "true": 1,
            "false": 0,
            "1": 1,
            "0": 0,
            "yes": 1,
            "no": 0,
        }
        converted = normalized.map(mapping)

        # If the column contains other representations, try numeric conversion.
        if converted.notna().sum() == 0:
            converted = pd.to_numeric(df[TARGET], errors="coerce")

        df[TARGET] = converted
    else:
        df[TARGET] = pd.to_numeric(df[TARGET], errors="coerce")

    df = df[df[TARGET].isin([0, 1])].copy()
    df[TARGET] = df[TARGET].astype(int)

    if df.empty:
        raise ValueError("No rows with a valid binary target remain.")

    return df


def make_features(df):
    """
    Create model features from available columns.

    The target is excluded. Identifiers and raw dates are excluded;
    month and weekday are represented using dummy variables.
    """

    X = pd.DataFrame(index=df.index)

    # Numeric predictors: use only columns available in the dataset.
    numeric_candidates = [
        "cci",
        "growth_30d",
        "growth_snp500_30d",
        "DGS10",
        "DGS5",
        "FEDFUNDS",
    ]

    for column in numeric_candidates:
        if column in df.columns:
            X[column] = pd.to_numeric(df[column], errors="coerce")

    # Month and weekday dummy variables.
    if "Month" in df.columns:
        month = df["Month"]

        if pd.api.types.is_numeric_dtype(month):
            month_values = month
        else:
            month_values = pd.to_datetime(
                month, errors="coerce"
            ).dt.month

        X["Month"] = month_values

    elif "Date" in df.columns:
        X["Month"] = df["Date"].dt.month

    if "Weekday" in df.columns:
        weekday = df["Weekday"]

        if pd.api.types.is_numeric_dtype(weekday):
            X["Weekday"] = weekday
        else:
            weekday_names = {
                "monday": 0,
                "tuesday": 1,
                "wednesday": 2,
                "thursday": 3,
                "friday": 4,
                "saturday": 5,
                "sunday": 6,
            }
            mapped = weekday.astype(str).str.lower().map(weekday_names)

            # If weekday values are not names, try numeric conversion.
            if mapped.notna().sum() > 0:
                X["Weekday"] = mapped
            else:
                X["Weekday"] = pd.to_numeric(
                    weekday, errors="coerce"
                )

    elif "Date" in df.columns:
        X["Weekday"] = df["Date"].dt.dayofweek

    # Include additional numeric columns, excluding identifiers,
    # the target, and columns that directly encode future outcomes.
    excluded_names = {
        TARGET.lower(),
        "date",
        "ticker",
        "symbol",
        "growth_30d_future",
        "is_positive_growth_30d_future",
    }

    for column in df.columns:
        if column in X.columns:
            continue

        if column.lower() in excluded_names:
            continue

        if column.lower().startswith("is_positive_growth"):
            continue

        if "future" in column.lower():
            continue

        if pd.api.types.is_numeric_dtype(df[column]):
            X[column] = df[column]

    # Remove duplicate columns, if any.
    X = X.loc[:, ~X.columns.duplicated()]

    # Replace infinite values with missing values.
    X = X.replace([np.inf, -np.inf], np.nan)

    # Keep columns with at least one observed value.
    X = X.dropna(axis=1, how="all")

    if X.empty:
        raise ValueError(
            "No usable numeric features were found. "
            "Check the dataset's column names."
        )

    return X


def split_and_impute(X, y):
    """
    Split the data and impute missing numeric values using training
    medians only, avoiding information leakage from the test set.
    """

    X_train, X_test, y_train, y_test = train_test_split(
        X,
        y,
        test_size=TEST_SIZE,
        random_state=RANDOM_STATE,
        stratify=y if y.nunique() > 1 else None,
    )

    # Remove features entirely missing in the training subset.
    usable_columns = X_train.columns[
        X_train.notna().any(axis=0)
    ]

    X_train = X_train[usable_columns].copy()
    X_test = X_test[usable_columns].copy()

    medians = X_train.median(numeric_only=True)

    X_train = X_train.fillna(medians).fillna(0)
    X_test = X_test.fillna(medians).fillna(0)

    return X_train, X_test, y_train, y_test


